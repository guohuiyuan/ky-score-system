{{define "header.tmpl"}}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{if .Title}}{{.Title}}{{else}}843考研分数统计系统{{end}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/ky/static/css/style.css">
    <style>
        :root {
            --hit-blue: #0033a0;
            --hit-blue-light: #1a4ab5;
        }
        body { background-color: #f5f6fa; font-size: 0.9rem; }
        .text-purple { color: var(--hit-blue) !important; font-weight: bold; }
        .bg-purple { background-color: var(--hit-blue); color: white; }

        /* 顶部导航 */
        .top-bar {
            background: linear-gradient(135deg, var(--hit-blue) 0%, #001f66 100%);
            height: 4px;
        }
        .navbar {
            background: white !important;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
            padding: 0.5rem 0;
        }
        .navbar-brand {
            font-weight: 700;
            color: var(--purple) !important;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .navbar-brand .school-logo {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--hit-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: white;
            font-weight: bold;
            flex-shrink: 0;
        }
        .navbar-brand .school-text {
            font-size: 0.65rem;
            color: #888;
            font-weight: normal;
            display: block;
            line-height: 1.2;
        }
        .nav-link {
            color: #555 !important;
            font-size: 0.875rem;
        }
        .nav-link:hover { color: var(--hit-blue) !important; }
        .btn-fill-score {
            background: var(--hit-blue);
            color: white;
            border: none;
            border-radius: 4px;
            padding: 5px 14px;
            font-size: 0.875rem;
            font-weight: 500;
        }
        .btn-fill-score:hover { background: var(--hit-blue-light); color: white; }

        /* 卡片 */
        .card { border: none; box-shadow: 0 2px 8px rgba(0,0,0,0.06); border-radius: 8px; }

        /* 批量操作按钮 */
        .batch-btn-approve { background-color: #28a745; color: white; border: none; border-radius: 4px; padding: 5px 12px; font-size: 0.82rem; font-weight: 500; }
        .batch-btn-reject  { background-color: #fd7e14; color: white; border: none; border-radius: 4px; padding: 5px 12px; font-size: 0.82rem; font-weight: 500; }
        .batch-btn-delete  { background-color: #dc3545; color: white; border: none; border-radius: 4px; padding: 5px 12px; font-size: 0.82rem; font-weight: 500; }

        /* 操作按钮 (行内) */
        .btn-action-verify  { background: #28a745; color: white; border: none; font-size: 0.78rem; padding: 2px 8px; border-radius: 3px; }
        .btn-action-edit    { background: var(--hit-blue); color: white; border: none; font-size: 0.78rem; padding: 2px 8px; border-radius: 3px; }
        .btn-action-reject  { background: #fd7e14; color: white; border: none; font-size: 0.78rem; padding: 2px 8px; border-radius: 3px; }
        .btn-action-delete  { background: #dc3545; color: white; border: none; font-size: 0.78rem; padding: 2px 8px; border-radius: 3px; }

        /* 表格 */
        .table th {
            background-color: #f8f9fa;
            color: #555;
            font-weight: 600;
            font-size: 0.82rem;
            border-bottom: 2px solid #e9ecef;
        }
        .table td { font-size: 0.86rem; vertical-align: middle; }
        .table-hover tbody tr:hover { background-color: #edf3ff; }

        /* 状态徽章 */
        .badge-approved { color: #28a745; font-weight: 600; }
        .badge-rejected { color: #dc3545; font-weight: 600; }
        .badge-pending  { color: #fd7e14; font-weight: 600; }

        /* 密钥截断 */
        .key-cell { font-family: monospace; font-size: 0.8rem; color: #888; max-width: 90px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

        /* 排名行高亮 */
        .rank-highlight { background-color: #fff9e6 !important; }
        .rank-badge-me { background: #f0b800; color: white; font-size: 0.7rem; padding: 1px 5px; border-radius: 3px; margin-left: 4px; }
    </style>
</head>
<body>
<div class="top-bar"></div>
<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="/ky/">
            <div class="school-logo">哈</div>
            <div>
                <span>哈工大计算机考研分数统计系统</span>
                <span class="school-text">Harbin Institute of Technology</span>
            </div>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center">
                {{if .CurrentUser}}
                <li class="nav-item">
                    <a class="nav-link fw-bold text-hit-blue" href="/ky/" style="color:var(--hit-blue) !important;"><i class="bi bi-trophy me-1"></i>查看排名</a>
                </li>
                <li class="nav-item ms-lg-3">
                    <a class="btn btn-fill-score shadow-sm" href="/ky/submit"><i class="bi bi-pencil-square me-1"></i>更新分数</a>
                </li>
                <li class="nav-item ms-lg-3">
                    <a class="nav-link text-danger" href="/ky/logout"><i class="bi bi-box-arrow-right me-1"></i>退出验证</a>
                </li>
                {{else}}
                <li class="nav-item">
                    <a class="nav-link fw-bold text-hit-blue" href="/ky/login" style="color:var(--hit-blue) !important;"><i class="bi bi-shield-lock me-1"></i>验证身份 / 查排名</a>
                </li>
                <li class="nav-item ms-lg-3">
                    <a class="btn btn-fill-score shadow-sm" href="/ky/submit"><i class="bi bi-pencil-square me-1"></i>首次填写分数</a>
                </li>
                {{end}}
                <li class="nav-item ms-lg-2">
                    <a class="nav-link text-muted" href="/ky/admin" target="_blank" title="管理员控制台"><i class="bi bi-incognito fs-5"></i></a>
                </li>
            </ul>
        </div>
    </div>
</nav>
<div class="container mt-3">
{{end}}