{{define "public/login.tmpl"}}
{{template "header.tmpl" .}}

<style>
    .login-card {
        border: none; border-radius: 14px; overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,51,160,0.1);
    }
    .login-header {
        background: linear-gradient(135deg, var(--hit-blue) 0%, #1a5cff 100%);
        color: white; padding: 2rem; text-align: center;
    }
    .login-header h3 { font-weight: 700; margin: 8px 0 0; }
    .login-header p { opacity: 0.8; font-size: 0.85rem; margin: 6px 0 0; }
</style>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="login-card card my-4">
            <div class="login-header">
                <i class="bi bi-shield-lock-fill" style="font-size:2.5rem;opacity:0.9"></i>
                <h3>身份验证</h3>
                <p>输入您的专属密钥以查看排名或修改成绩</p>
            </div>
            <div class="card-body p-4">
                {{if .Error}}
                <div class="alert alert-danger d-flex align-items-center py-2 px-3" style="font-size:0.85rem;border-radius:8px;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>{{.Error}}
                </div>
                {{end}}

                <form method="POST" action="/ky/login">
                    <div class="mb-4">
                        <label for="secret_key" class="form-label fw-semibold text-secondary">专属密钥 <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="secret_key" name="secret_key"
                            placeholder="请输入提交时获得的密钥" required
                            style="border-radius:8px;padding:12px 14px;border:1px solid #d2e3fc;background:#f8fafc;">
                    </div>
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-lg text-white fw-bold"
                            style="background:linear-gradient(135deg,var(--hit-blue),#1a5cff);border:none;border-radius:8px;">
                            <i class="bi bi-box-arrow-in-right me-1"></i>进入系统
                        </button>
                    </div>
                </form>

                <div class="text-center mt-3 pt-3 border-top">
                    <p class="text-muted small mb-1">忘记密钥或首次使用？</p>
                    <a href="/ky/submit" class="text-decoration-none fw-bold" style="color:var(--hit-blue)">
                        <i class="bi bi-pencil-square me-1"></i>去提交成绩
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{{template "footer.tmpl" .}}
{{end}}
