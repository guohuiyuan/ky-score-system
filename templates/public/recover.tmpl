{{define "public/recover.tmpl"}}
{{template "header.tmpl" .}}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card my-4 shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                    <div class="me-3">
                        <i class="bi bi-search text-primary" style="font-size: 2rem; color: var(--hit-blue) !important;"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1" style="color: #333;">找回专属密钥</h4>
                        <p class="text-muted mb-0" style="font-size: 0.85rem;">只要准确输入您之前提交的以下成绩信息，即可找回您的密钥。</p>
                    </div>
                </div>

                <form id="recoverForm">
                    <div class="row g-3">
                        {{range .RecoverFields}}
                        <div class="col-sm-6">
                            <label class="form-label fw-bold" style="font-size: 0.85rem; color: #555;">{{.Label}} <span class="text-danger">*</span></label>
                            
                            {{if eq .Type "number"}}
                            <input type="number" step="0.1" class="form-control" name="{{.Key}}" placeholder="请输入精准分数" required>
                            {{else if eq .Type "select"}}
                            <select class="form-select" name="{{.Key}}" required>
                                <option value="" disabled selected>请选择</option>
                                {{range .Options}}
                                <option value="{{.}}">{{.}}</option>
                                {{end}}
                            </select>
                            {{else}}
                            <input type="text" class="form-control" name="{{.Key}}" required>
                            {{end}}
                        </div>
                        {{end}}
                    </div>

                    <div id="resultMessage" class="mt-4 d-none p-3 rounded text-center">
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a href="/ky/login" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>返回登录</a>
                        <button type="submit" class="btn btn-primary px-4" style="background: var(--hit-blue); border: none;" id="btnSubmit">
                            <span class="spinner-border spinner-border-sm d-none me-2" role="status" aria-hidden="true" id="loadingSpinner"></span>
                            查询密钥
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('recoverForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const btnSubmit = document.getElementById('btnSubmit');
    const spinner = document.getElementById('loadingSpinner');
    const resultDiv = document.getElementById('resultMessage');
    
    btnSubmit.disabled = true;
    spinner.classList.remove('d-none');
    resultDiv.classList.add('d-none');
    
    const formData = new FormData(this);
    
    fetch('/ky/recover', {
        method: 'POST',
        body: formData
    })
    .then(res => res.json().then(data => ({status: res.status, body: data})))
    .then(response => {
        resultDiv.classList.remove('d-none');
        if(response.status === 200) {
            resultDiv.className = 'mt-4 p-3 rounded text-center bg-success text-white';
            resultDiv.innerHTML = `
                <div class="mb-2"><i class="bi bi-check-circle fs-3"></i></div>
                <div class="fw-bold fs-5 mb-1">找到了！</div>
                <div>您的专属密钥是: <strong style="font-family: monospace; user-select: all; cursor: pointer; background: rgba(0,0,0,0.2); padding: 2px 8px; border-radius: 4px;" title="双击复制" onclick="navigator.clipboard.writeText('${response.body.secret_key}'); alert('已复制!');">${response.body.secret_key}</strong> </div>
                <div class="mt-3"><a href="/ky/login" class="btn btn-light btn-sm text-success fw-bold">现在去登录</a></div>
            `;
        } else {
            resultDiv.className = 'mt-4 p-3 rounded text-center bg-danger text-white';
            resultDiv.innerHTML = `
                <div class="mb-1"><i class="bi bi-x-circle fs-4"></i></div>
                <div>${response.body.error}</div>
            `;
        }
    })
    .catch(err => {
        resultDiv.classList.remove('d-none');
        resultDiv.className = 'mt-4 p-3 rounded text-center bg-danger text-white';
        resultDiv.innerHTML = '网络请求失败，请稍后重试。';
    })
    .finally(() => {
        btnSubmit.disabled = false;
        spinner.classList.add('d-none');
    });
});
</script>

{{template "footer.tmpl" .}}
{{end}}
