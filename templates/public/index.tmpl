{{define "public/index.tmpl"}}
{{template "header.tmpl" .}}

<div class="card mb-4">
    <div class="card-body px-4 py-4">
        <!-- 标题区 -->
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="text-muted" style="font-size:1.6rem;">🏫</span>
                    <h4 class="mb-0 fw-bold" style="color:#222;">{{.ExamName}}</h4>
                </div>
                <div class="text-muted" style="font-size:0.82rem;">2026年考分数实时排行榜（支持多维度组合筛选）</div>
            </div>
            <div class="d-flex align-items-center gap-2">
                {{if .CurrentUser}}
                <div class="bg-light px-3 py-2 rounded shadow-sm border" style="font-size:0.85rem;">
                    欢迎，<span class="fw-bold text-hit-blue">{{.CurrentUser.Nickname}}</span>
                    <div class="text-muted" style="font-size:0.75rem;">总分 {{.CurrentUser.TotalScore}}</div>
                </div>
                {{end}}
                <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1 shadow-sm" onclick="location.reload()">
                    <i class="bi bi-arrow-clockwise"></i> 刷新数据
                </button>
            </div>
        </div>

        <!-- Info Bar -->
        <div class="d-flex align-items-center mb-4 px-3 py-2 rounded" style="background:#f0f9f0; border-left: 4px solid #28a745; font-size:0.88rem; color:#555;">
            <i class="bi bi-info-circle-fill text-success me-2"></i>
            数据仅供参考，绿色高亮行为预测录取区间 (1:1.5) 内。总计 <strong class="text-danger mx-1">{{.TotalCount}}</strong> 人提交。
        </div>

        <!-- 排名表区 -->
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0 fw-bold" style="color:#333;">
                <i class="bi bi-list-ol text-purple me-1"></i> 详细排名表
            </h6>
            <span class="badge rounded-pill" style="background:#e8effa; color:var(--hit-blue); font-weight:600;">共 {{.TotalCount}} 人提交</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle shadow-sm bg-white rounded overflow-hidden" id="rankTable">
                <thead style="background-color: var(--hit-blue); color: white;">
                    <tr>
                        <th class="text-center" style="width: 60px;">排名</th>
                        <th class="text-start">ID (昵称)</th>
                        {{range .DynamicHeaders}}
                            <th class="text-center">{{.Label}}</th>
                        {{end}}
                        <th class="text-center text-warning fw-bold">总分</th>
                        <th class="text-center">状态</th>
                    </tr>
                </thead>
                <tbody>    {{if not .Records}}
                    <tr><td colspan="10" class="text-muted py-4">暂无数据</td></tr>
                    {{end}}

                    {{range $index, $row := .Records}}
                    <tr>
                        <td class="text-muted fw-bold">{{$row.Rank}}</td>
                        <td class="text-start">{{$row.Nickname}}</td>
                        <td class="text-purple fw-bold">{{$row.TotalScore}}</td>
                        
                        {{range $.DynamicHeaders}}
                            <td>
                                {{$val := index $row.DynamicData .Key}}
                                {{if $val}}{{$val}}{{else}}<span class="text-muted">-</span>{{end}}
                            </td>
                        {{end}}

                        <td>
                            {{if eq $row.Status "approved"}}
                                <span class="badge bg-success" style="font-size:0.75rem;">● 已核验</span>
                            {{else if eq $row.Status "rejected"}}
                                <span class="badge bg-danger" style="font-size:0.75rem;">✖ 已驳回</span>
                            {{else}}
                                <span class="badge bg-secondary" style="font-size:0.75rem;">待核验</span>
                            {{end}}
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 引入 jQuery 和 DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<style>
    /* DataTables 定制样式以搭配现有 UI */
    .dataTables_wrapper .row { align-items: center; margin-bottom: 15px; }
    .dataTables_filter input { border-color: #ddd; box-shadow: none; }
    .dataTables_filter input:focus { border-color: var(--hit-blue); }
    table.dataTable thead th { border-bottom: none; }
    .page-item.active .page-link { background-color: var(--hit-blue); border-color: var(--hit-blue); }
    
    /* 让表头搜索框紧凑点 */
    .col-search-input { width: 100%; padding: 2px 4px; border: 1px solid #ddd; border-radius: 4px; font-size: 0.8rem; margin-top: 5px; color: #333; font-weight: normal; }
</style>

<script>
$(document).ready(function() {
    // 自动在表头下方加一行搜索框
    $('#rankTable thead tr').clone(true).addClass('filters').appendTo('#rankTable thead');

    var table = $('#rankTable').DataTable({
        "order": [], // 取消默认排序，保留现有基于总分的后端排序
        "pageLength": 50,
        "language": {
            "sProcessing":   "处理中...",
            "sLengthMenu":   "每页 _MENU_ 项",
            "sZeroRecords":  "没有匹配结果",
            "sInfo":         "显示第 _START_ 至 _END_ 项结果，共 _TOTAL_ 项",
            "sInfoEmpty":    "显示第 0 至 0 项结果，共 0 项",
            "sInfoFiltered": "(由 _MAX_ 项结果过滤)",
            "sInfoPostFix":  "",
            "sSearch":       "全局模糊搜索:",
            "sUrl":          "",
            "sEmptyTable":     "表中数据为空",
            "sLoadingRecords": "载入中...",
            "sInfoThousands":  ",",
            "oPaginate": {
                "sFirst":    "首页",
                "sPrevious": "上页",
                "sNext":     "下页",
                "sLast":     "末页"
            },
            "oAria": {
                "sSortAscending":  ": 以升序排列此列",
                "sSortDescending": ": 以降序排列此列"
            }
        },
        orderCellsTop: true,
        fixedHeader: true,
        initComplete: function () {
            var api = this.api();
 
            // 为每个过滤行中的 th 添加 select 下拉框
            api.columns().eq(0).each(function (colIdx) {
                var cell = $('.filters th').eq($(api.column(colIdx).header()).index());
                var title = $(cell).text().trim();
                
                // 排除"这列不是表头"的情况
                if(title === ""){
                    return;
                }

                // 生成下拉框包裹
                var select = $('<select class="col-search-input"><option value="">所有' + title + '</option></select>')
                    .appendTo($(cell).empty())
                    .on('change', function () {
                        // 精确匹配，为了处理例如 "985" 和 "211" 这样可能被模糊搜索混淆的情况，
                        // 用 ^ 和 $ 包裹转义序列
                        var val = $.fn.dataTable.util.escapeRegex($(this).val());
                        api.column(colIdx)
                            .search(val ? '^' + val + '$' : '', true, false)
                            .draw();
                    });
                
                // 将该列中所有非空的唯一值加入到下拉框中选项
                api.column(colIdx).data().unique().sort().each(function (d, j) {
                    // 去除可能包含的 HTML 标签（如果有头像等）
                    var textData = $('<div>').html(d).text().trim();
                    if(textData) {
                        select.append('<option value="' + textData + '">' + textData + '</option>');
                    }
                });
            });
        }
    });
});
</script>

{{template "footer.tmpl" .}}
{{end}}