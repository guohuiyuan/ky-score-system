{{define "admin/change_password.tmpl"}}
{{template "header.tmpl" .}}

<style>
    .pwd-card { border:none; border-radius:14px; overflow:hidden; box-shadow:0 8px 30px rgba(0,51,160,0.1); }
    .pwd-header {
        background:linear-gradient(135deg, #fd7e14 0%, #e74c3c 100%);
        color:white; padding:2rem; text-align:center;
    }
    .pwd-header h4 { font-weight:700; margin:8px 0 0; }
    .pwd-header p { opacity:0.85; font-size:0.85rem; margin:6px 0 0; }
</style>

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">
        <div class="pwd-card card">
            <div class="pwd-header">
                <i class="bi bi-key-fill" style="font-size:2.5rem;opacity:0.9"></i>
                <h4>修改管理员密码</h4>
                <p>首次登录需要修改默认密码</p>
            </div>
            <div class="card-body p-4">
                {{if .Error}}
                <div class="alert alert-danger d-flex align-items-center py-2 px-3" style="font-size:0.85rem;border-radius:8px;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>{{.Error}}
                </div>
                {{end}}

                <form action="/ky/admin/change-password" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">当前密码</label>
                        <input type="password" name="old_password" class="form-control" placeholder="输入当前密码" required
                            style="border-radius:8px;padding:10px 14px;">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">新密码 <small class="text-muted">(至少6位)</small></label>
                        <input type="password" name="new_password" class="form-control" placeholder="输入新密码" required minlength="6"
                            style="border-radius:8px;padding:10px 14px;">
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary">确认新密码</label>
                        <input type="password" name="confirm_password" class="form-control" placeholder="再次输入新密码" required minlength="6"
                            style="border-radius:8px;padding:10px 14px;">
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-lg text-white fw-bold"
                            style="background:linear-gradient(135deg,var(--hit-blue),#1a5cff);border:none;border-radius:8px;">
                            <i class="bi bi-check-lg me-1"></i>确认修改
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{{template "footer.tmpl" .}}
{{end}}
