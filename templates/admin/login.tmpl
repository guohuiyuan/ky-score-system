{{define "admin/login.tmpl"}}
{{template "header.tmpl" .}}

<div class="row justify-content-center mt-5">
    <div class="col-md-4 col-sm-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h4 class="text-purple fw-bold">核验管理控制台</h4>
                    <p class="text-muted">请使用管理员账号登录</p>
                </div>
                
                <form action="/ky/admin/login" method="POST">
                    <div class="mb-3">
                        <label class="form-label">账号</label>
                        <input type="text" name="username" class="form-control" placeholder="admin" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">密码</label>
                        <input type="password" name="password" class="form-control" placeholder="admin123" required>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn bg-purple text-white">登 录</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{{template "footer.tmpl" .}}
{{end}}