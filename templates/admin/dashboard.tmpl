{{define "admin/dashboard.tmpl"}}
{{template "header.tmpl" .}}

<style>
    .dash-card { border:none; border-radius:14px; overflow:hidden; box-shadow:0 4px 20px rgba(0,51,160,0.07); }
    .dash-hero {
        background: linear-gradient(135deg, var(--hit-blue) 0%, #1a5cff 100%);
        color:white; padding:1.2rem 1.5rem;
        display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;
    }
    .dash-hero h5 { font-weight:700; margin:0; }
    .dash-hero .sub { opacity:0.8; font-size:0.8rem; }
    .dash-hero .btn-light-ghost {
        background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.2);
        color:white; border-radius:6px; font-size:0.8rem; padding:5px 12px;
    }
    .toolbar { background:#f8fafd; border-bottom:1px solid #eef2f7; padding:12px 20px; }
    .toolbar select, .toolbar input[type="text"] {
        border:1px solid #d2e3fc; border-radius:6px; padding:5px 10px; font-size:0.82rem;
    }
    .toolbar select:focus, .toolbar input:focus { border-color:var(--hit-blue); outline:none; box-shadow:0 0 0 3px rgba(0,51,160,0.08); }
    .batch-bar { padding:10px 20px; background:white; border-bottom:1px solid #f0f2f5; display:flex; justify-content:space-between; align-items:center; }
    .batch-btn { border:none; border-radius:6px; padding:5px 14px; font-size:0.8rem; font-weight:600; color:white; }
    .batch-btn.approve { background:#28a745; } .batch-btn.reject { background:#fd7e14; } .batch-btn.delete { background:#dc3545; }

    .dash-table { width:100%; border-collapse:collapse; }
    .dash-table thead th {
        background:#1a3a6c; color:#d6e4f5; font-weight:600; font-size:0.76rem;
        padding:10px 10px; border:none; white-space:nowrap; text-align:center;
    }
    .dash-table tbody td {
        padding:8px 10px; font-size:0.82rem; color:#333; border-bottom:1px solid #f0f2f5;
        white-space:nowrap; text-align:center; vertical-align:middle;
    }
    .dash-table tbody tr:nth-child(even) { background:#f9fbfe; }
    .dash-table tbody tr:hover { background:#edf3ff; }
    .action-btn { border:none; border-radius:4px; padding:3px 8px; font-size:0.72rem; font-weight:600; color:white; cursor:pointer; }
    .action-btn.verify { background:#28a745; } .action-btn.reject { background:#fd7e14; } .action-btn.delete { background:#dc3545; }

    @media(max-width:768px) {
        .dash-hero { padding:1rem; }
        .toolbar { padding:10px 12px; }
        .dash-table thead th { font-size:0.7rem; padding:8px 6px; }
        .dash-table tbody td { font-size:0.76rem; padding:6px 6px; }
    }
</style>

<div class="dash-card card mb-4">
    <!-- 页头 -->
    <div class="dash-hero">
        <div>
            <h5><i class="bi bi-clipboard-check me-2"></i>核验管理控制台</h5>
            <div class="sub">共 {{len .Records}} 条记录</div>
        </div>
        <div class="d-flex gap-2">
            <a href="/ky/" class="btn-light-ghost"><i class="bi bi-list-ol me-1"></i>排名</a>
            <a href="/ky/admin/change-password" class="btn-light-ghost"><i class="bi bi-key me-1"></i>改密码</a>
            <a href="/ky/admin/logout" class="btn-light-ghost"><i class="bi bi-box-arrow-right me-1"></i>退出</a>
        </div>
    </div>

    <!-- 搜索与筛选 -->
    <form class="toolbar d-flex flex-wrap align-items-center gap-2" method="GET" action="/ky/admin/dashboard">
        <div class="input-group" style="width:auto">
            <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius:6px 0 0 6px;border-color:#d2e3fc"><i class="bi bi-search"></i></span>
            <input type="text" class="border-start-0 ps-0" name="search" placeholder="搜昵称/准考证" value="{{.SearchKw}}" style="border-radius:0 6px 6px 0;border-color:#d2e3fc;padding:5px 10px;font-size:0.82rem;border:1px solid #d2e3fc;border-left:none;">
        </div>
        <select name="status">
            <option value="">所有状态</option>
            <option value="pending" {{if eq .StatusFilter "pending"}}selected{{end}}>待审核</option>
            <option value="approved" {{if eq .StatusFilter "approved"}}selected{{end}}>已通过</option>
            <option value="rejected" {{if eq .StatusFilter "rejected"}}selected{{end}}>已驳回</option>
        </select>
        <button type="submit" class="btn btn-sm text-white fw-bold" style="background:var(--hit-blue);border:none;border-radius:6px;padding:5px 16px;font-size:0.82rem;">检索</button>
        <a href="/ky/admin/dashboard" class="btn btn-sm btn-outline-secondary" style="border-radius:6px;font-size:0.78rem;"><i class="bi bi-arrow-counterclockwise"></i> 重置</a>

        <div class="ms-auto d-flex gap-2 flex-wrap">
            <a href="/ky/api/admin/export-excel" class="btn btn-sm btn-outline-primary fw-bold" style="border-radius:6px;font-size:0.78rem;"><i class="bi bi-download me-1"></i>导出</a>
            <a href="/ky/api/admin/excel-template" class="btn btn-sm btn-outline-success fw-bold" style="border-radius:6px;font-size:0.78rem;"><i class="bi bi-file-earmark-excel me-1"></i>模板</a>
            <button type="button" class="btn btn-sm btn-success fw-bold" style="border-radius:6px;font-size:0.78rem;" onclick="showImportModal()"><i class="bi bi-upload me-1"></i>导入Excel</button>
        </div>
    </form>

    <!-- 批量操作 -->
    <div class="batch-bar">
        <div class="d-flex gap-2">
            <button class="batch-btn approve" onclick="batchVerify('approved')">批量通过</button>
            <button class="batch-btn reject" onclick="batchVerify('rejected')">批量驳回</button>
            <button class="batch-btn delete" onclick="batchDelete()">批量删除</button>
        </div>
        <span class="text-muted" id="selectedCount" style="font-size:0.8rem">已选 0 项</span>
    </div>

    <!-- 数据表 -->
    <div class="table-responsive">
        <table class="dash-table">
            <thead>
                <tr>
                    <th style="width:36px"><input type="checkbox" class="form-check-input" id="selectAll"></th>
                    <th>时间</th>
                    <th class="text-start">ID (昵称)</th>
                    <th>准考证后6</th>
                    {{range .DynamicHeaders}}
                        <th>{{.Label}}</th>
                    {{end}}
                    <th style="color:#ffd700">总分</th>
                    <th>密钥</th>
                    <th>IP</th>
                    <th>截图</th>
                    <th>状态</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                {{range $index, $row := .Records}}
                <tr id="row-{{$row.ID}}">
                    <td><input type="checkbox" class="form-check-input record-checkbox" value="{{$row.ID}}" onchange="updateSelectedCount()"></td>
                    <td class="text-muted" style="font-size:0.76rem">{{$row.CreatedAt.Format "01-02 15:04"}}</td>
                    <td class="text-start fw-semibold">{{$row.Nickname}}</td>
                    <td style="color:#e74c3c;font-family:monospace;font-size:0.8rem">{{$row.TicketPrefix}}</td>
                    {{range $.DynamicHeaders}}
                        <td style="font-size:0.8rem">
                            {{$val := index $row.DynamicData .Key}}
                            {{if and $val (eq .Key "direction")}}
                                {{$val}}
                            {{else if $val}}{{$val}}
                            {{else}}-{{end}}
                        </td>
                    {{end}}
                    <td class="fw-bold" style="color:var(--hit-blue)">{{$row.TotalScore}}</td>
                    <td style="white-space:nowrap">
                        <span class="badge bg-light text-secondary border fw-normal" style="font-family:monospace;font-size:0.75rem;padding:4px 6px;" title="{{$row.SecretKey}}">
                            {{if gt (len $row.SecretKey) 8}}{{slice $row.SecretKey 0 8}}…{{else}}{{$row.SecretKey}}{{end}}
                        </span>
                        <button class="btn btn-sm btn-outline-secondary p-1 ms-1" style="line-height:1;border-color:#dee2e6;color:#6c757d;" title="复制密钥" onclick="copyKey(this,'{{$row.SecretKey}}')"><i class="bi bi-files" style="font-size:0.7rem;"></i></button>
                    </td>
                    <td class="text-muted" style="font-size:0.76rem">{{$row.IPAddress}}</td>
                    <td>
                        {{if $row.ProofImage}}
                        <button type="button" class="btn btn-sm btn-outline-secondary p-1" title="查看" onclick="showImage('{{$row.ProofImage}}')"><i class="bi bi-image"></i></button>
                        {{else}}<span class="text-muted">-</span>{{end}}
                    </td>
                    <td id="status-{{$row.ID}}">
                        {{if eq $row.Status "approved"}}<span class="badge-approved"><i class="bi bi-check-circle-fill me-1"></i>通过</span>
                        {{else if eq $row.Status "rejected"}}<span class="badge-rejected"><i class="bi bi-x-circle-fill me-1"></i>驳回</span>
                        {{else}}<span class="badge-pending"><i class="bi bi-clock-fill me-1"></i>待核</span>{{end}}
                    </td>
                    <td>
                        <div class="d-flex gap-1 justify-content-center">
                            <button class="action-btn verify" onclick="updateStatus({{$row.ID}}, 'approved')">核验</button>
                            <button class="action-btn reject" onclick="updateStatus({{$row.ID}}, 'rejected')">驳回</button>
                            <button class="action-btn delete" onclick="deleteRecord({{$row.ID}})">删除</button>
                        </div>
                    </td>
                </tr>
                {{end}}
                {{if not .Records}}
                <tr><td colspan="20" class="text-muted py-5">暂无数据</td></tr>
                {{end}}
            </tbody>
        </table>
    </div>
</div>

<!-- 图片预览 Modal -->
<div class="modal fade" id="imgModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius:12px;overflow:hidden">
            <div class="modal-header border-0 pb-0"><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body text-center pt-0"><img id="modalImg" src="" alt="截图" class="img-fluid rounded"></div>
        </div>
    </div>
</div>

<!-- Excel 导入 Modal -->
<div class="modal fade" id="importModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content" style="border-radius:12px;overflow:hidden">
      <div class="modal-header" style="background:linear-gradient(135deg,#28a745,#20c997);color:white;border:none;">
        <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-excel me-1"></i> 批量导入成绩</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="importForm" onsubmit="event.preventDefault();">
            <div class="mb-3">
                <label for="excel_file" class="form-label text-muted">请先 <a href="/ky/api/admin/excel-template" class="text-success fw-bold text-decoration-none">下载模板</a> 并填写数据后再上传</label>
                <input class="form-control" type="file" id="excel_file" name="excel_file" accept=".xlsx" required style="border-radius:8px">
            </div>
        </form>
        <div id="importResult" class="d-none mt-3 p-3 rounded"></div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <div class="w-100 d-grid">
            <button type="button" class="btn btn-success btn-lg fw-bold" id="btnUpload" onclick="uploadExcel()" style="border-radius:8px">
                <span class="spinner-border spinner-border-sm d-none me-2" role="status" id="importSpinner"></span>开始导入
            </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 驳回理由输入 Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:12px;overflow:hidden">
      <div class="modal-header" style="background:#fde8e8;border-bottom:none">
        <h5 class="modal-title fw-bold" style="color:#dc3545"><i class="bi bi-x-circle-fill me-1"></i> 填写驳回理由</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label class="form-label text-muted" style="font-size:0.85rem">请输入驳回理由（可选，前台用户将看到此原因）：</label>
        <textarea id="rejectReasonInput" class="form-control" rows="3" placeholder="例如：截图不清晰、总分填写错误等..." style="border-radius:8px;resize:none;"></textarea>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:8px">取消</button>
        <button type="button" class="btn btn-danger fw-bold" id="btnConfirmReject" style="border-radius:8px">确定驳回</button>
      </div>
    </div>
  </div>
</div>

<script>
let imgModalInstance, importModalInstance;

function showImage(src) {
    if (!imgModalInstance) imgModalInstance = new bootstrap.Modal(document.getElementById('imgModal'));
    document.getElementById('modalImg').src = src;
    imgModalInstance.show();
}
function showImportModal() {
    if (!importModalInstance) importModalInstance = new bootstrap.Modal(document.getElementById('importModal'));
    document.getElementById('importResult').classList.add('d-none');
    document.getElementById('importForm').reset();
    importModalInstance.show();
}
function uploadExcel() {
    const f = document.getElementById('excel_file');
    if (!f.files || !f.files.length) { alert("请先选择文件"); return; }
    const btn = document.getElementById('btnUpload'), sp = document.getElementById('importSpinner'), res = document.getElementById('importResult');
    btn.disabled = true; sp.classList.remove('d-none'); res.classList.add('d-none');
    const fd = new FormData(); fd.append("excel_file", f.files[0]);
    fetch('/ky/api/admin/import-excel', {method:'POST', body:fd})
    .then(r => r.json().then(d => ({status:r.status, body:d})))
    .then(r => {
        res.classList.remove('d-none');
        if(r.status===200) { res.className='mt-3 p-3 rounded bg-success text-white fw-bold text-center'; res.innerHTML=`<i class="bi bi-check-circle me-1"></i>${r.body.message}`; setTimeout(()=>location.reload(),2000); }
        else { res.className='mt-3 p-3 rounded bg-danger text-white fw-bold text-center'; res.innerHTML=`<i class="bi bi-x-circle me-1"></i>${r.body.error}`; }
    }).catch(()=>{ res.classList.remove('d-none'); res.className='mt-3 p-3 rounded bg-danger text-white text-center'; res.innerHTML='网络错误'; })
    .finally(()=>{ btn.disabled=false; sp.classList.add('d-none'); });
}

document.getElementById('selectAll').addEventListener('change', function() {
    document.querySelectorAll('.record-checkbox').forEach(cb => cb.checked = this.checked);
    updateSelectedCount();
});
function updateSelectedCount() {
    document.getElementById('selectedCount').textContent = `已选 ${document.querySelectorAll('.record-checkbox:checked').length} 项`;
}
function getSelectedIDs() {
    return Array.from(document.querySelectorAll('.record-checkbox:checked')).map(cb => parseInt(cb.value));
}
function showRejectModal(callback) {
    const modal = new bootstrap.Modal(document.getElementById('rejectModal'));
    const input = document.getElementById('rejectReasonInput');
    const btnConfirm = document.getElementById('btnConfirmReject');
    
    input.value = ''; // 清空上次输入
    
    // 移除之前的事件监听，防止多次绑定
    const newBtnConfirm = btnConfirm.cloneNode(true);
    btnConfirm.parentNode.replaceChild(newBtnConfirm, btnConfirm);
    
    newBtnConfirm.addEventListener('click', () => {
        modal.hide();
        callback(input.value.trim());
    });
    
    modal.show();
}

function updateStatus(id, status) {
    if (status === 'rejected') {
        showRejectModal((reason) => {
            executeVerify(id, status, reason);
        });
    } else {
        executeVerify(id, status, "");
    }
}

function executeVerify(id, status, reason) {
    fetch(`/ky/admin/api/verify/${id}`, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({status, reason})})
    .then(r=>r.json()).then(d=>{
        if(d.error){alert(d.error);return;}
        const td=document.getElementById(`status-${id}`);
        td.innerHTML=status==='approved'?'<span class="badge-approved"><i class="bi bi-check-circle-fill me-1"></i>通过</span>':'<span class="badge-rejected"><i class="bi bi-x-circle-fill me-1"></i>驳回</span>';
    });
}

function deleteRecord(id) {
    if(!confirm('确定删除？'))return;
    fetch(`/ky/admin/api/record/${id}`,{method:'DELETE'}).then(r=>r.json()).then(d=>{if(d.error)alert(d.error);else document.getElementById(`row-${id}`).remove();});
}

function batchVerify(status) {
    const ids=getSelectedIDs();if(!ids.length){alert('请先勾选');return;}
    if (status === 'rejected') {
        showRejectModal((reason) => {
            executeBatchVerify(ids, status, reason);
        });
    } else {
        if(!confirm(`确定批量通过 ${ids.length} 条记录吗？`))return;
        executeBatchVerify(ids, status, "");
    }
}

function executeBatchVerify(ids, status, reason) {
    fetch('/ky/admin/api/batch-verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids,status,reason})})
    .then(r=>r.json()).then(d=>{if(d.error)alert(d.error);else location.reload();});
}

function batchDelete() {
    const ids=getSelectedIDs();if(!ids.length){alert('请先勾选');return;}
    if(!confirm(`确定批量删除${ids.length}条？`))return;
    fetch('/ky/admin/api/batch-delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ids})}).then(r=>r.json()).then(d=>{if(d.error)alert(d.error);else location.reload();});
}
function copyKey(btn, key) {
    const fallback = () => {
        const el = document.createElement('textarea');
        el.value = key;
        document.body.appendChild(el);
        el.select();
        try { document.execCommand('copy'); } catch(e) {}
        document.body.removeChild(el);
        showCopySuccess(btn);
    };
    if (navigator.clipboard) {
        navigator.clipboard.writeText(key).then(() => showCopySuccess(btn)).catch(fallback);
    } else {
        fallback();
    }
}
function showCopySuccess(btn) {
    const originalHtml = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-check2" style="font-size:0.8rem;color:#198754;font-weight:bold;"></i>';
    setTimeout(() => { btn.innerHTML = originalHtml; }, 1500);
}
</script>

{{template "footer.tmpl" .}}
{{end}}